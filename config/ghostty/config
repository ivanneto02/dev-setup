# tmux-style tab navigation
keybind = ctrl+b>c=new_tab
keybind = ctrl+b>n=next_tab
keybind = ctrl+b>p=previous_tab

# Jump directly to tabs
keybind = ctrl+b>0=goto_tab:1
keybind = ctrl+b>1=goto_tab:2
keybind = ctrl+b>2=goto_tab:3
keybind = ctrl+b>3=goto_tab:4
keybind = ctrl+b>4=goto_tab:5
keybind = ctrl+b>5=goto_tab:6

# Vim-style pane navigation
keybind = ctrl+b>h=goto_split:left
keybind = ctrl+b>j=goto_split:down
keybind = ctrl+b>k=goto_split:up
keybind = ctrl+b>l=goto_split:right

# Tmux-style pane creation
keybind = ctrl+b>v=new_split:down
keybind = ctrl+b>s=new_split:right

# Close current pane
keybind = ctrl+b>x=close_surface
# Zoom/unzoom current pane
keybind = ctrl+b>z=toggle_split_zoom


# Config syntax crash course
# ==========================
# # The config file consists of simple key-value pairs,
# # separated by equals signs.
# font-family = Iosevka
window-padding-x = 10
window-padding-y = 10
#
# # Spacing around the equals sign does not matter.
# # All of these are identical:
# key=value
# key= value
# key =value
# key = value
#
# # Any line beginning with a # is a comment. It's not possible to put
# # a comment after a config option, since it would be interpreted as a
# # part of the value. For example, this will have a value of "#123abc":
theme = Catppuccin Frappe
background = #000000
background-opacity = 0.9
#
# # Empty values are used to reset config keys to default.
# key =
#
# # Some config options have unique syntaxes for their value,
# # which is explained in the docs for that config option.
# # Just for example:
# resize-overlay-duration = 4s 200ms
